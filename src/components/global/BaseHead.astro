---
export interface ShareImage {
	src: string;      // site-relative or absolute URL of a JPEG
	width: number;
	height: number;
	alt?: string;
}

interface Props {
	pageTitle: string;
	pageDescription?: string;
	shareImage?: ShareImage;   // per-page link-preview image (defaults to og-image.jpg)
	ogType?: "website" | "article";
}

const { pageTitle, pageDescription, shareImage, ogType = "website" } = Astro.props;
const siteUrl = Astro.site?.origin ?? "https://stoa60.net";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const thumbnail = shareImage ? new URL(shareImage.src, siteUrl).href : `${siteUrl}/og-image.jpg`;
const thumbWidth = shareImage?.width ?? 1200;
const thumbHeight = shareImage?.height ?? 630;
const description = pageDescription ?? "support your local diy scene";
---
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="description" content={description} />
	<meta name="generator" content={Astro.generator} />
	<meta name="robots" content="index, follow" />
	<meta name="googlebot" content="index, follow" />

	<!-- Canonical -->
	<link rel="canonical" href={canonicalUrl} />

	<!-- Open Graph -->
	<meta property="og:type" content={ogType} />
	<meta property="og:site_name" content="STOA60" />
	<meta property="og:title" content={`Stoa60 - ${pageTitle}`} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={thumbnail} />
	<meta property="og:image:width" content={String(thumbWidth)} />
	<meta property="og:image:height" content={String(thumbHeight)} />
	<meta property="og:image:type" content="image/jpeg" />
	{shareImage?.alt && <meta property="og:image:alt" content={shareImage.alt} />}
	<meta property="og:url" content={canonicalUrl} />

	<!-- Twitter Card -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={`Stoa60 - ${pageTitle}`} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={thumbnail} />

	<link rel="icon" href="/favicon.ico" sizes="any" />
	<link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="apple-touch-icon" href="/favicon.png" />
	<title>Stoa60 - {pageTitle}</title>
</head>

